# Archivos de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales (si usas alguno)
venv/
.venv/
env/

# Compilación del .exe (PyInstaller): se rearma con REPORTE3.spec.
build/
dist/

# Archivos y carpetas generadas por el script de Arrienda
Reportes_Guardados/
*.docx
*.csv
*.json
# Contrato PC ↔ app Android: es fuente, no un reporte generado.
!android/app/src/test/resources/contrato/*.json
# Ejemplo de configuración del servidor (servidor.json es de cada instalación).
!servidor.ejemplo.json
*.html

# Licencias de Office: la planilla y la base tienen las keys, no van al repo.
*.xls
*.xlsx
licencias_office.db
licencias_office.db-journal

# Archivos temporales del sistema
.DS_Store
Thumbs.db

# Claves SSH — el envío por SCP necesita la clave privada AL LADO del exe, así
# que es normal que aparezca una acá al armar el paquete para FOG. Nunca debe
# entrar al repositorio: quien la tenga puede escribir en el NAS.
id_clonado
id_ed25519
id_rsa
id_ecdsa
clave_scp
*.pem
*.ppk
# La clave pública del servidor tampoco hace falta en el repo.
id_clonado.pub
# Pruebas
.pytest_cache/

# Configuración personal del editor y de herramientas.
.vscode/
.claude/
.idea/
